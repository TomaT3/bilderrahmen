# ESP32-S3-PhotoPainter: 16 MB Flash, Octal-PSRAM (wie in der Waveshare-Demo)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# HTTPS mit Zertifikatsprüfung über das CA-Bundle von ESP-IDF
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Der Schlaf-Timer läuft über den internen RC-Takt; mehr Kalibrierzyklen = weniger Drift über 24 h
CONFIG_RTC_CLK_CAL_CYCLES=3000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
